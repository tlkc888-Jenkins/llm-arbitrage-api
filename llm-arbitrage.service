[Unit]
Description=LLM Arbitrage API
After=network.target

[Service]
Type=simple
User=node
WorkingDirectory=/home/node/.openclaw/workspace/projects/llm-arbitrage-api
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=10
Environment=PORT=8080
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
